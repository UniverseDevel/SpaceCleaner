<Window x:Class="SpaceCleaner.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean up selected files" Height="640" Width="1040" MinHeight="360" MinWidth="640"
        Icon="spacecleaner.ico" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="Summary" Text="Preparing…" FontWeight="SemiBold" />
                <ProgressBar x:Name="Bar" Height="8" Margin="0,8" Minimum="0" Maximum="1" Value="0" />
                <DockPanel LastChildFill="False">
                    <CheckBox x:Name="FailedFilter" DockPanel.Dock="Left" Content="Show only skipped"
                              VerticalAlignment="Center" IsEnabled="False"
                              Checked="FailedFilter_OnToggled" Unchecked="FailedFilter_OnToggled" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Padding="12,5"
                            Margin="8,0,0,0" Click="Close_OnClick" />
                    <Button x:Name="RescanButton" DockPanel.Dock="Right" Content="🔄 Re-scan now" Padding="12,5"
                            Margin="8,0,0,0" Visibility="Collapsed" Click="Rescan_OnClick"
                            ToolTip="Close and scan again to see what remains." />
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Padding="12,5"
                            Click="Cancel_OnClick" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFF6E5" BorderBrush="#F0C36D" BorderThickness="0,1,0,0"
                Padding="12,8" x:Name="RescanHint" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap">
                Cleanup finished. <Run Text="Re-scan" FontWeight="SemiBold" /> to refresh the totals and check for anything else worth removing.
            </TextBlock>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      BorderThickness="0" RowHeaderWidth="0"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      MouseDoubleClick="Grid_OnDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110" />
                    <DataGridTextColumn Header="Full path" Binding="{Binding Path}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" SortMemberPath="Status" Width="340">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{Binding Status, Converter={StaticResource CleanupStatusBrush}}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="Loading" Text="Preparing…" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="#6B7480" />
        </Grid>
    </DockPanel>
</Window>
