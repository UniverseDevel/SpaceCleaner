<Window x:Class="SpaceCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceCleaner"
        xmlns:vm="clr-namespace:SpaceCleaner.ViewModels"
        xmlns:model="clr-namespace:SpaceCleaner.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="SpaceCleaner — Reclaim Disk Space"
        Icon="spacecleaner.ico"
        Height="720" Width="1120" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="White">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SpaceCleaner" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Find temporary files and caches that are safe to remove — review what's found, then reclaim the space."
                               Foreground="#DCE8F6" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderCaption}" Foreground="#DCE8F6" FontSize="11"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding HeaderValueText}" Foreground="White"
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left: drive selection + progress -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock Text="Drives to scan" FontWeight="SemiBold" FontSize="14"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="↻ Refresh" DockPanel.Dock="Right" Padding="8,3"
                                Command="{Binding RefreshDrivesCommand}"
                                ToolTip="Re-detect connected drives." />
                    </DockPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:DriveItem}">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Center">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SpaceSummary}" Style="{StaticResource Muted}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <CheckBox Content="Include all user profiles" Margin="0,0,0,8"
                                  IsChecked="{Binding IncludeAllUserProfiles}"
                                  ToolTip="Also scan every other account under C:\Users, not just yours. Cloud-synced folders are always skipped." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Scan" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ScanCommand}" />
                            <Button Content="Cancel" Style="{StaticResource ToolButton}"
                                    Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Grid.Row="3" Margin="0,14,0,10" />

                    <TextBlock Grid.Row="4" Text="Scan progress" FontWeight="SemiBold" FontSize="14" />

                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding ScanStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:DriveScanStatus}">
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                           DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}"
                                                           DockPanel.Dock="Right" FontSize="11" />
                                            </DockPanel>
                                            <ProgressBar Height="8" Margin="0,6" Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate}" />
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SizeBrush}"
                                                           Text="{Binding BytesText}" Margin="8,0,0,0" />
                                                <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                                           Text="{Binding CurrentPath}"
                                                           ToolTip="{Binding CurrentPath}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: results tree + detail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="240" MinHeight="150" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Results — biggest first. Each folder's size includes everything inside it. Tick what you want to act on."
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,7,0,0">
                                    <TextBlock Text="Quick select:" VerticalAlignment="Center" Margin="0,4,8,4"
                                               Style="{StaticResource Muted}" />
                                    <Button Content="All" Padding="10,3" Margin="0,0,6,4"
                                            Command="{Binding SelectAllCommand}"
                                            ToolTip="Select everything found. Press again to clear." />
                                    <Button Content="Temp &amp; Logs" Padding="8,3" Margin="0,0,12,4"
                                            Command="{Binding SelectTempAndLogsCommand}"
                                            ToolTip="Select temporary files, logs and crash dumps (excludes caches). Press again to clear." />

                                    <TextBlock Text="By safety:" VerticalAlignment="Center" Margin="0,4,8,4"
                                               Style="{StaticResource Muted}" />
                                    <Button Padding="8,3" Margin="0,0,6,4" Command="{Binding SelectSafeCommand}"
                                            ToolTip="Select locations that regenerate automatically with no downside. Press again to clear.">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#2E9E5B" />
                                            <TextBlock Text="Safe" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="8,3" Margin="0,0,6,4" Command="{Binding SelectCautionCommand}"
                                            ToolTip="Select locations that are fine to remove but will be re-downloaded or rebuilt. Press again to clear.">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#E0922F" />
                                            <TextBlock Text="Caution" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="8,3" Margin="0,0,12,4" Command="{Binding SelectReviewCommand}"
                                            ToolTip="Select locations that may hold wanted data or affect rollback (Recycle Bin, Windows.old…). Press again to clear.">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Fill="#D6453D" />
                                            <TextBlock Text="Review" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="By re-download:" VerticalAlignment="Center" Margin="0,4,8,4"
                                               Style="{StaticResource Muted}" />
                                    <Button Content="Redownloadable" Padding="8,3" Margin="0,0,6,4"
                                            Command="{Binding SelectRedownloadableCommand}"
                                            ToolTip="Select caches that would be re-downloaded from the internet on next use. Press again to clear." />
                                    <Button Content="Non-redownloadable" Padding="8,3" Margin="0,0,12,4"
                                            Command="{Binding SelectNonRedownloadableCommand}"
                                            ToolTip="Select everything except caches that would be re-downloaded on next use. Press again to clear." />

                                    <Button Content="🗔 View selected files" Padding="8,3" Margin="0,0,6,4"
                                            Click="ViewSelectedFiles_OnClick" IsEnabled="{Binding HasSelection}"
                                            ToolTip="Open a window listing every file under the checked items (full path + size). You can save it to CSV from there." />
                                    <Button Content="🗑 Clean up selected…" Style="{StaticResource DangerButton}"
                                            Padding="10,3" Margin="0,0,0,4"
                                            Click="CleanupSelected_OnClick" IsEnabled="{Binding HasSelection}"
                                            ToolTip="Permanently delete the files under the checked items. Files in use or protected are skipped. Writes an audit log next to the app." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <TreeView ItemsSource="{Binding Results}" BorderThickness="0"
                                      SelectedItemChanged="ResultsTree_OnSelectedItemChanged"
                                      ItemContainerStyle="{StaticResource ResultTreeItem}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type model:ScanNode}"
                                                              ItemsSource="{Binding Children}">
                                        <Grid ToolTip="{Binding FullPath}" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      IsThreeState="False" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      ToolTip="Tick to include this location when you view or clean up the selection." />
                                            <Ellipse Grid.Column="1" Width="9" Height="9" Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding SafetyLevel, Converter={StaticResource SafetyBrush}}"
                                                     Visibility="{Binding ShowSafety, Converter={StaticResource BoolToVisibility}}"
                                                     ToolTip="{Binding SafetyText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding KindGlyph}" Margin="0,0,6,0" />
                                            <DockPanel Grid.Column="3" LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="(aggregated)"
                                                           Style="{StaticResource Muted}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="6,0,8,0"
                                                           Visibility="{Binding ChildrenAggregated, Converter={StaticResource BoolToVisibility}}"
                                                           ToolTip="Deeper subfolders are summed into this size but not listed individually." />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1,0,0,0" Padding="12,0,4,0">
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SizeBrush}" />
                                            </Border>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>

                            <TextBlock Text="Nothing scanned yet. Pick your drives on the left and press Scan."
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="320" IsHitTestVisible="False"
                                       Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisible}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <!-- Detail pane -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid Margin="14">
                        <!-- Placeholder when nothing is selected -->
                        <TextBlock Text="Select an item to see why it's safe to remove, what it typically contains, and its potential risks — or open it in Explorer."
                                   Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" MaxWidth="420"
                                   Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisible}}" />

                        <!-- Detail for the selected node -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedNode}"
                                      Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="15" />
                                        <TextBlock Text="{Binding FullPath}" Style="{StaticResource Muted}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="9,4" VerticalAlignment="Top"
                                            Background="{Binding SafetyLevel, Converter={StaticResource SafetyBrush}}"
                                            Visibility="{Binding ShowSafety, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{Binding SafetyBlurb}">
                                        <TextBlock Text="{Binding SafetyText}" Foreground="White"
                                                   FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="{Binding SafetyRationale}" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding ShowSafety, Converter={StaticResource BoolToVisibility}}" />

                                <WrapPanel Margin="0,8,0,0">
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="Total size" Style="{StaticResource Muted}" FontSize="10" />
                                            <TextBlock Text="{Binding SizeText}" FontWeight="Bold"
                                                       Foreground="{StaticResource SizeBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Text="Files in this folder" Style="{StaticResource Muted}" FontSize="10" />
                                            <TextBlock Text="{Binding OwnFileSizeText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Button Content="📂 Open in Explorer" VerticalAlignment="Center" Padding="12,6"
                                            Command="{Binding DataContext.OpenInExplorerCommand,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </WrapPanel>

                                <TextBlock Text="Why this is safe" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding WhySafeText}" TextWrapping="Wrap" />

                                <StackPanel Visibility="{Binding TypicalContentsText, Converter={StaticResource NullOrEmptyToCollapsed}}">
                                    <TextBlock Text="What it usually contains" FontWeight="SemiBold" Margin="0,10,0,2" />
                                    <TextBlock Text="{Binding TypicalContentsText}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                                        Background="{Binding SafetyLevel, Converter={StaticResource SafetyTint}}"
                                        BorderBrush="{Binding SafetyLevel, Converter={StaticResource SafetyBrush}}"
                                        Visibility="{Binding ShowSafety, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                                     Fill="{Binding SafetyLevel, Converter={StaticResource SafetyBrush}}" />
                                            <TextBlock Text="Potential risks" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding PotentialRisks}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" />
        </Border>
    </Grid>
</Window>
